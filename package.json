    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "ai": "6.0.282",
    "deepmerge-ts": "8.0.2",
    "nanoid": "3.3.19",
    "expr-eval": "npm:@keep-lts/expr-eval@2.0.3"
  },
  "engines": {

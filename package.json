{
  "name": "@workingcuriosity/piece-sekalum",
  "version": "0.1.0",
  "description": "Sekalum Consumer API piece for Activepieces",
  "license": "MIT",
  "homepage": "https://github.com/workingcuriosity/sekalum-activepieces#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workingcuriosity/sekalum-activepieces.git"
  },
